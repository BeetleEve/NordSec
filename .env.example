# Copy to .env only for manual setup. main.py creates a local .env itself.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_NAME=nordsec
DB_USER=nordsec
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
NORDSEC_LOCAL_CLUSTER=0
NORDSEC_DEMO=0
NORDSEC_BEHIND_HTTPS_PROXY=0
# Local development prints reset emails in the server console. Configure SMTP for delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=NordSec <noreply@localhost>

# Map providers: visible tiles are cached by the local proxy.
MAP_TILE_URL=/map/tiles/{z}/{x}/{y}.png
MAP_TILE_UPSTREAM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_GEOCODER_URL=https://nominatim.openstreetmap.org/search
